# Copy to .env and adjust. .env is gitignored.
#
# Only DELEGATE_WORKSPACE_ROOTS is required -- it is layer 1 of the path policy, and
# there is no safe default for "which files may a model read".
#
# Every setting, its default and what it does: docs/CONFIGURATION.md (generated from
# src/claude_delegate_local/config.py -- never edit it by hand).
#
# An unknown DELEGATE_* name is read by nothing and reported by nothing, so a stale line
# here looks like live configuration. Delete a line when you stop needing it rather than
# commenting it out somewhere else.

# Separated by os.pathsep: ';' on Windows, ':' elsewhere -- so on the POSIX host the
# server runs on, a Windows path cannot go here: the drive's colon is the separator, and
# `C:\Users\you\projects` loads as the two roots `C` and `\Users\you\projects`. Write the
# translated form, which is what `--init` writes for you.
DELEGATE_WORKSPACE_ROOTS=/mnt/c/Users/you/projects

DELEGATE_MODELS_FILE=./models.toml

# --- commonly adjusted ---
# DELEGATE_THINKING_DEFAULT=low
# DELEGATE_MAX_TURNS_DEFAULT=25
# DELEGATE_MAX_INFLIGHT_SEQS=5
# DELEGATE_DISPATCH_TIMEOUT=3600

# --- prefetch ---
# The files[] budget per call and the per-file cap inside it. A cold prefill is silence
# that DELEGATE_STALL_TIMEOUT counts, so lower both when you raise
# DELEGATE_MAX_INFLIGHT_SEQS; max_total_prefetch_tokens in docs/CONFIGURATION.md says by
# how much. The values below are an example of lowering them, not the defaults.
# DELEGATE_MAX_TOTAL_PREFETCH_TOKENS=140000
# DELEGATE_MAX_FILE_TOKENS=140000

# --- sampling: leave these alone unless you are measuring something ---
# The defaults are the pair this model was evaluated at, and 0.2 is what made five audit
# passes loop inside a single turn. Raising temperature does not cost tool-call syntax --
# 96 calls from 0.2 to 1.5 produced no malformed one -- but 2.0 stops the model calling
# tools at all. See ADR-0098.
# DELEGATE_TEMPERATURE=1.0
# DELEGATE_TOP_P=0.95

# --- deadlines ---
# Two, and only two: silence and total time. stall_timeout is silence from the endpoint,
# not slowness -- frames arrive every 0.4s or better while the model reasons, and a
# running tool cannot trip it. It is also the httpx read budget, so it bounds silence at
# the socket too. See ADR-0099.
# DELEGATE_STALL_TIMEOUT=900

# --- migrating from a pre-2026-09-21 .env ---
# DELEGATE_TOOL_CALL_TEMPERATURE and DELEGATE_ONE_SHOT_TEMPERATURE are retired. They are
# refused at load rather than ignored, so the server will not start until the lines are
# deleted. Use DELEGATE_TEMPERATURE.
#
# DELEGATE_TURN_TIMEOUT is retired too, and refused the same way. Nothing replaces it:
# a wedged call is a silent one, so DELEGATE_STALL_TIMEOUT is what catches it, and
# DELEGATE_DISPATCH_TIMEOUT still bounds the whole delegation.
