# --- local scratch ---
# Benchmark probes: a WSL-created venv under /mnt/c contains symlinks that
# Git Bash cannot even index, so an accidental `git add -A` fails outright.
.bench/
.bench-venv/
.spike/
*.local.md

# Chunked scratch from ad hoc investigations. Twelve such files, ~1.35 MB of
# fragments of a proprietary compiled binary, were found untracked in the repo
# root with nothing in the repository referencing them. Root-anchored, so a
# legitimately tracked tmp_* elsewhere is unaffected.
/tmp_*
